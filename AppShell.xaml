<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Dadchanger.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dadchanger">

    <ShellContent
        x:Name="MainPageContent"
        Title="Dadchanger"
        Route="mainpage" />

    <ShellContent
        x:Name="PreviousGamesPageContent"
        Title="Previous Games"
        Route="previousgames"
        Shell.FlyoutItemIsVisible="False" />

    <ShellContent
        x:Name="GameReportPageContent"
        Title="Game Report"
        Route="gamereport"
        Shell.FlyoutItemIsVisible="False" />

    <ShellContent
        x:Name="GamePageContent"
        Title="Game"
        Route="game"
        Shell.FlyoutItemIsVisible="False" />

    <ShellContent
        x:Name="PitchingPageContent"
        Title="Pitching"
        Route="pitching"
        Shell.FlyoutItemIsVisible="False" />

    <ShellContent
        x:Name="BattingPageContent"
        Title="Batting"
        Route="batting"
        Shell.FlyoutItemIsVisible="False" />

</Shell>
