<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dadchanger.PitchingPage"
             Title="Pitching">
    <ScrollView>
        <StackLayout Padding="24" Spacing="12">
            <Label Text="{Binding CurrentInning.InningNumber, StringFormat='Inning {0}'}"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center" />
            <Button Text="Strike" Command="{Binding StrikeCommand}" />
            <Button Text="Ball" Command="{Binding BallCommand}" />
            <Button Text="Hit" Command="{Binding HitCommand}" />

            <StackLayout IsVisible="{Binding ShowPitchTypeOptions}" Spacing="8">
                <Button Text="Fastball" Command="{Binding FastballCommand}" />
                <Button Text="Curveball" Command="{Binding CurveballCommand}" />
                <Button Text="Changeup" Command="{Binding ChangeupCommand}" />
            </StackLayout>

            <StackLayout IsVisible="{Binding ShowHitResultOptions}" Spacing="8">
                <Button Text="Single" Command="{Binding SingleCommand}" />
                <Button Text="Double" Command="{Binding DoubleCommand}" />
                <Button Text="Triple" Command="{Binding TripleCommand}" />
                <Button Text="Foulball" Command="{Binding FoulballCommand}" />
                <Button Text="Out" Command="{Binding OutCommand}" />
            </StackLayout>

            <StackLayout IsVisible="{Binding ShowOutTypeOptions}" Spacing="8">
                <Button Text="Ground Out" Command="{Binding GroundOutCommand}" />
                <Button Text="Fly Out" Command="{Binding FlyOutCommand}" />
            </StackLayout>

            <Button Text="End Inning" Command="{Binding EndInningCommand}" />
        </StackLayout>
    </ScrollView>
</ContentPage>
