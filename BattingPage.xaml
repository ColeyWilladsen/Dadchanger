<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dadchanger.BattingPage"
             Title="Batting">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="{Binding CurrentAtBat.AtBatNumber, StringFormat='At Bat {0}'}"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center" />
            <Label Text="{Binding Balls, StringFormat='Balls: {0}'}"
                   HorizontalOptions="Center" />
            <Label Text="{Binding Strikes, StringFormat='Strikes: {0}'}"
                   HorizontalOptions="Center" />
            <Button Text="Take" Command="{Binding TakeCommand}" />
            <Button Text="Swing" Command="{Binding SwingCommand}" />
            <Button Text="End At Bat" Command="{Binding EndAtBatCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
