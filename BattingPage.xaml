<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dadchanger.BattingPage"
             Title="Batting">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="{Binding CurrentAtBat.AtBatNumber, StringFormat='At Bat {0}'}"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center" />
            <Label Text="{Binding Balls, StringFormat='Balls: {0}'}"
                   HorizontalOptions="Center" />
            <Label Text="{Binding Strikes, StringFormat='Strikes: {0}'}"
                   HorizontalOptions="Center" />
            <Button Text="Take" Command="{Binding TakeCommand}" />
            <VerticalStackLayout IsVisible="{Binding IsTakeChoicesVisible}" Spacing="8">
                <Button Text="Ball" Command="{Binding TakeBallCommand}" />
                <Button Text="Strike" Command="{Binding TakeStrikeCommand}" />
            </VerticalStackLayout>
            <Button Text="Swing" Command="{Binding SwingCommand}" />
            <VerticalStackLayout IsVisible="{Binding IsSwingChoicesVisible}" Spacing="8">
                <Button Text="Hit" Command="{Binding SwingHitCommand}" />
                <Button Text="Miss" Command="{Binding SwingMissCommand}" />
            </VerticalStackLayout>
            <VerticalStackLayout IsVisible="{Binding IsHitChoicesVisible}" Spacing="8">
                <Button Text="Single" Command="{Binding SingleCommand}" />
                <Button Text="Double" Command="{Binding DoubleCommand}" />
                <Button Text="Triple" Command="{Binding TripleCommand}" />
                <Button Text="Foulball" Command="{Binding FoulBallCommand}" />
                <Button Text="Out" Command="{Binding OutCommand}" />
            </VerticalStackLayout>
            <VerticalStackLayout IsVisible="{Binding IsOutChoicesVisible}" Spacing="8">
                <Button Text="Ground Out" Command="{Binding GroundOutCommand}" />
                <Button Text="Fly Out" Command="{Binding FlyOutCommand}" />
            </VerticalStackLayout>
            <Button Text="End At Bat" Command="{Binding EndAtBatCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
